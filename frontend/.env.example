# Required for production builds. Development without this file uses the Vite proxy.
VITE_API_BASE=http://127.0.0.1:8000

# Static demo build (the GitHub Pages site): serve every /api/* response from
# public/demo-data/ instead of a backend. Mutually exclusive with VITE_API_BASE;
# see docs/deployment.md ("Static demo site").
# VITE_STATIC_MODE=1
